# ==============================================================================
# SciClub Manager - Variables d'environnement
# Copiez ce fichier vers .env et renseignez vos informations réelles.
# NE JAMAIS COMMITER LE FICHIER .ENV DANS VOTRE DÉPÔT GIT.
# ==============================================================================

# Environnement et Logging
NODE_ENV=development
LOG_LEVEL=info

# Discord Bot Credentials
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Discord OAuth2 Configuration (Web Dashboard)
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Serveur Web & API
PORT=3001
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=super_secret_session_key_sciclub_at_least_32_characters_long

# Chemins de persistance
DATABASE_PATH=../../data/sciclub.sqlite
CONFIG_PATH=../../config/guilds
BACKUP_PATH=../../config/backups
